<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Jar of Stars</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=Space+Mono&display=swap" rel="stylesheet">
<style>
:root{--cream:#fbf1e7;--kraft:#c99a5b;--blue:#3c6fb5;--ink:#4a3f38;--paper:#e6d6c3;--mono:'Space Mono',ui-monospace,monospace;--serif:'Cormorant Garamond',Georgia,serif;--jar:min(250px,60vw)}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;overflow-x:hidden}
body{background:radial-gradient(circle at 50% 0,#fff8f0,var(--cream) 60%,#f7e3d2);font-family:var(--mono);color:var(--ink);min-height:100vh;min-height:100dvh}
main{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;padding:28px 16px 0}
h1{font:500 clamp(2rem,6vw,2.6rem)/1.1 var(--serif);color:var(--blue);margin:0 0 8px}
#count{margin:0 0 22px;font-size:.95rem;text-align:center}
.kraft{position:fixed;left:0;right:0;bottom:0;height:34vh;background:linear-gradient(#d2a56a,var(--kraft));z-index:1;
clip-path:polygon(0 8%,6% 5%,12% 7%,19% 3%,27% 6%,34% 2%,42% 5%,50% 1%,58% 5%,66% 2%,74% 6%,82% 3%,90% 6%,96% 3%,100% 6%,100% 100%,0 100%)}
.jar{position:relative;width:var(--jar);aspect-ratio:428/720;padding:0;border:0;background:none;cursor:pointer;filter:drop-shadow(0 14px 14px rgba(80,50,20,.25));-webkit-tap-highlight-color:transparent;transform-origin:50% 100%}
.sway{width:var(--jar);transform-origin:50% 100%;animation:sway 6s ease-in-out infinite;pointer-events:none}
.sway .jar{pointer-events:auto}
@keyframes sway{0%,100%{transform:rotate(-1.5deg) translateY(0)}50%{transform:rotate(1.5deg) translateY(-5px)}}
.jar svg{position:absolute;inset:0;width:100%;height:100%}
.jar:focus-visible,.pill:focus-visible,.star:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
.jar.shaking{animation:shake .8s ease-in-out}
@keyframes shake{0%,100%{transform:rotate(0)}15%{transform:rotate(-7deg) translateX(-6px)}30%{transform:rotate(6deg) translateX(6px)}45%{transform:rotate(-5deg)}60%{transform:rotate(4deg)}80%{transform:rotate(-2deg)}}
.jar-img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;pointer-events:none}
/* area tempat bintang bergerak; sesuaikan jika toples PNG berbeda bentuk */
#stars{position:absolute;left:var(--sl,10%);right:var(--sr,10%);top:var(--st,24%);bottom:var(--sb,5%)}
.star.img span,.flystar.img span{clip-path:none;background:var(--img) center/contain no-repeat}
.star{position:absolute;left:0;top:0;width:34px;height:34px;padding:0;border:0;background:none;cursor:pointer;filter:drop-shadow(0 2px 2px rgba(0,0,0,.25));will-change:transform}
.star span,.flystar span{display:block;width:100%;height:100%;background:linear-gradient(135deg,color-mix(in srgb,var(--c) 70%,#fff),var(--c) 55%,color-mix(in srgb,var(--c) 80%,#000));
clip-path:polygon(50% 0,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%);transition:transform .2s}
.star:hover span,.star:focus-visible span{transform:scale(1.25)}
.flystar{position:fixed;left:0;top:0;width:34px;height:34px;z-index:50;pointer-events:none;filter:drop-shadow(0 0 12px #ffd36b) drop-shadow(0 3px 3px rgba(0,0,0,.3));will-change:transform,opacity}
.spark{position:absolute;width:6px;height:6px;border-radius:50%;background:#ffe7a3;box-shadow:0 0 8px #ffd36b;pointer-events:none;animation:spark .9s ease-out forwards}
@keyframes spark{to{transform:translate(var(--dx),var(--dy)) scale(0);opacity:0}}
.pill{font:inherit;font-size:.9rem;color:var(--ink);background:#f1e6dc;border:0;border-radius:10px;padding:12px 16px;min-height:44px;cursor:pointer;box-shadow:0 2px 0 rgba(0,0,0,.08)}
.pill:hover{background:#f8eee5}
#openAdmin{position:fixed;right:14px;bottom:14px;z-index:5}
dialog{border:0;background:none;padding:0;max-width:100vw;max-height:100dvh;overflow:visible}
dialog::backdrop{background:rgba(251,241,231,.75);backdrop-filter:blur(4px)}
.card{position:relative;width:min(420px,92vw);max-height:92dvh;overflow:auto;background:var(--paper);padding:34px 28px 26px;text-align:center;
clip-path:polygon(0 2%,5% 0,12% 1.5%,20% 0,30% 1.5%,42% 0,55% 1.5%,68% 0,80% 1.5%,92% 0,100% 2%,99% 30%,100% 60%,98.5% 100%,90% 98.5%,75% 100%,60% 98.5%,40% 100%,22% 98.5%,8% 100%,0 98.5%,1.5% 60%,0 30%);animation:unfold .45s cubic-bezier(.2,.9,.3,1.2)}
@keyframes unfold{from{transform:scale(.5) rotate(-12deg);opacity:0}}
.tape{position:absolute;top:8px;left:50%;width:120px;height:30px;transform:translateX(-50%) rotate(-1deg);background:#d9b35c;opacity:.95;z-index:2}
.polaroid{margin:0 0 16px;padding:10px 10px 16px;background:#fff;transform:rotate(-1.5deg);box-shadow:0 2px 6px rgba(0,0,0,.2);aspect-ratio:4/3.4;display:flex}
.polaroid img{width:100%;height:100%;object-fit:cover}
.fallback{flex:1;display:grid;place-items:center;font-size:4rem;color:#f7a98b;background:#fff7ef}
h2{font:italic 1.5rem var(--mono);margin:0 0 10px}
time{display:block;color:#8a7b6e;margin-bottom:10px}
#mDesc{margin:0 0 18px;line-height:1.5;font-size:.9rem;white-space:pre-wrap}
.row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.admin{text-align:left}.admin h2{text-align:center;font-style:normal}
.admin label{display:block;margin-bottom:12px;font-size:.85rem}
.admin input,.admin textarea{display:block;width:100%;margin-top:4px;padding:10px;font:inherit;border:1px solid #c9b8a5;border-radius:8px;background:#fffaf4}
.polaroid.small{width:140px;aspect-ratio:1;margin:0 auto 12px}
#error{color:#a3321f;min-height:1.2em;font-size:.85rem}
#list{padding:0;list-style:none}#list li{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:6px 0;border-bottom:1px dashed #bda88f;font-size:.85rem}
.admin small{display:block;margin-top:12px;color:#7a6a5c}
@media (prefers-reduced-motion:reduce){.sway{animation:none!important}*{animation-duration:.01ms!important;transition-duration:.01ms!important}}


.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);opacity:0}
.tears{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin:26px 0 30px;filter:drop-shadow(0 2px 2px rgba(80,50,20,.35))}
.tape-btn{font:inherit;font-size:.95rem;color:#3b2d22;background:#e2b676;border:0;padding:15px 22px;min-height:48px;cursor:pointer;
clip-path:polygon(0 12%,4% 0,12% 8%,22% 0,35% 7%,48% 0,60% 8%,74% 0,88% 7%,100% 2%,98% 40%,100% 70%,97% 100%,85% 92%,70% 100%,55% 93%,40% 100%,25% 92%,10% 100%,2% 90%,0 55%);transition:transform .2s}
.tears .tape-btn:nth-child(2){clip-path:polygon(1% 5%,10% 0,25% 9%,40% 1%,55% 8%,70% 0,85% 8%,99% 0,100% 45%,98% 75%,100% 98%,88% 90%,72% 100%,58% 91%,42% 100%,28% 92%,12% 100%,0 94%,2% 60%,0 30%);transform:rotate(1deg)}
.tears .tape-btn:nth-child(1){transform:rotate(-1deg)}
.tape-btn:hover{transform:translateY(-2px) rotate(0)}
.tape-btn:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
.tape-btn b{color:#a3412f;margin-right:6px}
.page{max-width:640px;margin:0 auto;padding:18px 16px 50px;text-align:center}
.page h1.left{text-align:left;margin-bottom:12px}
.back{font:inherit;font-size:.9rem;color:var(--ink);background:none;border:0;padding:10px 4px;cursor:pointer;display:block;margin-bottom:6px;text-align:left}
.back::first-letter{color:#c0645a}
.sub{margin:6px 0 26px;font-size:.95rem}
.wrap{position:relative;filter:drop-shadow(0 3px 4px rgba(90,60,40,.18))}
.wrap .tape{top:-12px}
.note{background:linear-gradient(#ecdfd5,#dfcdc2);padding:42px 24px 24px;text-align:left;min-height:330px;display:flex;flex-direction:column;gap:14px}
.tear{clip-path:polygon(0 3%,3% 0,9% 2%,16% 0,24% 2%,33% 0,45% 2%,57% 0,68% 2%,79% 0,90% 2%,97% 0,100% 4%,99% 25%,100% 50%,98.5% 75%,100% 97%,92% 100%,80% 98%,66% 100%,52% 98%,38% 100%,25% 98%,12% 100%,3% 98%,0 96%,1.2% 70%,0 45%,1% 20%)}
#fText{flex:1;min-height:120px;resize:none;border:0;background:none;font:italic 1.2rem/1.7 var(--mono);color:var(--ink);outline:0}
#fText::placeholder{color:#b9a79a}
.meta{display:flex;justify-content:space-between;align-items:center;color:#8a7766;font-size:.85rem}
.meta input{font:inherit;color:#7a6858;background:none;border:0;padding:6px 0}
.pic{align-self:flex-start;display:inline-flex;gap:8px;align-items:center}
.pic:focus-within{outline:3px solid var(--blue)}
.drop{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;margin-top:14px;padding:20px;font:500 1.5rem var(--serif);color:#9c8478;background:#f3e8de;border:2px solid #e3d1c5;border-radius:20px;box-shadow:0 4px 8px rgba(120,80,50,.15);cursor:pointer}
.drop:hover{color:#6b5448}.drop:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
.mini{display:inline-block;width:22px;height:22px;flex:none;background:linear-gradient(135deg,color-mix(in srgb,var(--c,#f4b6c8) 70%,#fff),var(--c,#f4b6c8));clip-path:polygon(50% 0,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}
.mini.img{clip-path:none;background:var(--img) center/contain no-repeat}
.filter{text-align:right;margin:8px 0 22px;font-size:.85rem}
.filter label{display:block;margin-bottom:6px}
.filter select{appearance:none;filter:drop-shadow(0 2px 2px rgba(80,50,20,.3));padding-right:26px}
.cards{list-style:none;padding:0;margin:0 0 26px;display:grid;gap:16px}
.cards li{position:relative;max-width:420px;filter:drop-shadow(0 2px 3px rgba(90,60,40,.2));transform:rotate(var(--rot))}
.cards .open{display:grid;grid-template-columns:auto 1fr;column-gap:12px;row-gap:12px;align-items:center;width:100%;text-align:left;font:inherit;color:var(--ink);border:0;cursor:pointer;padding:22px 44px 22px 20px;background:linear-gradient(var(--tint),color-mix(in srgb,var(--tint) 85%,#b8a898));
clip-path:polygon(0 8%,5% 0,15% 6%,30% 0,48% 5%,65% 0,82% 6%,95% 0,100% 7%,98% 50%,100% 92%,92% 100%,76% 94%,58% 100%,40% 95%,22% 100%,8% 95%,0 100%,2% 55%)}
.cards .open strong{font:italic 1.1rem var(--mono);word-break:break-word}
.cards .open time{grid-column:2;color:#8a7766;font-size:.85rem;margin:0}
.cards .open:focus-visible{outline:3px solid var(--blue)}
.cards .del{position:absolute;top:8px;right:8px;width:40px;height:40px;border:0;background:none;font-size:1.4rem;color:#8a6a58;cursor:pointer;z-index:1}
.cards .del:hover{color:#a3321f}
#toast{position:fixed;left:50%;bottom:22px;transform:translate(-50%,30px);background:#4a3f38;color:#fff7ee;padding:12px 18px;border-radius:12px;font-size:.85rem;opacity:0;pointer-events:none;transition:.3s;z-index:60;max-width:90vw;text-align:center}
#toast.on{opacity:1;transform:translate(-50%,0)}
#mTitle{font-size:1.2rem;word-break:break-word}
.page small{display:block;margin-top:14px;color:#7a6a5c;font-size:.78rem}
[hidden]{display:none!important}
#listCount{text-align:left}
#memoryDialog .card{background:url("data:image/webp;base64,") center/100% 100% no-repeat;clip-path:none;padding:50px 40px 44px;filter:drop-shadow(0 8px 12px rgba(80,50,30,.3))}
#fTitle{width:100%;font:italic 1.35rem var(--mono);color:var(--ink);background:none;border:0;border-bottom:1px dashed #b9a79a;padding:6px 0;outline:0}
#fTitle::placeholder{color:#b9a79a}
#fTitle:focus,#fText:focus{border-color:var(--blue)}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
</style>
</head>
<body>
<div id="home">
<main>
  <h1>tap the jar</h1>
  <p id="count" aria-live="polite"></p>
  <div class="sway"><button id="jar" class="jar" aria-label="Goyang toples dan buka kenangan acak">
    <svg viewBox="0 0 300 440" aria-hidden="true">
      <defs>
        <linearGradient id="lid" x1="0" x2="1"><stop offset="0" stop-color="#9a9a9a"/><stop offset=".3" stop-color="#f2f2f2"/><stop offset=".6" stop-color="#bdbdbd"/><stop offset="1" stop-color="#8c8c8c"/></linearGradient>
        <linearGradient id="glass" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity=".95"/><stop offset=".5" stop-color="#fff" stop-opacity=".55"/><stop offset="1" stop-color="#fff" stop-opacity=".9"/></linearGradient>
      </defs>
      <path d="M52 78h196q38 10 38 52v270q0 36-40 36H54q-40 0-40-36V130q0-42 38-52z" fill="url(#glass)" stroke="#9aa0a6" stroke-width="3"/>
      <rect x="40" y="32" width="220" height="30" rx="5" fill="url(#lid)" stroke="#777"/>
      <rect x="32" y="60" width="236" height="20" rx="6" fill="url(#lid)" stroke="#777"/>
      <path d="M44 120v250" stroke="#fff" stroke-width="10" stroke-linecap="round" opacity=".8"/>
      <ellipse cx="150" cy="418" rx="110" ry="10" fill="none" stroke="#9aa0a6" opacity=".6"/>
    </svg>
    <img class="jar-img" alt="" hidden>
    <div id="stars"></div>
  </button></div>
  <nav class="tears" aria-label="menu">
    <button class="tape-btn" data-go="add"><b>+</b> add a star</button>
    <button class="tape-btn" data-go="list"><b>&#9733;</b> view all stars</button>
    <button class="tape-btn" id="shareJar"><b>&#10138;</b> share jar</button>
  </nav>
</main>
<div class="kraft" aria-hidden="true"></div>
</div>

<section id="addPage" class="page" hidden>
  <button class="back" data-go="home">&larr; back</button>
  <h1>add a memory</h1>
  <p class="sub">fold something small and happy into a star.</p>
  <form id="form" novalidate>
    <div class="wrap"><i class="tape"></i>
      <div class="note tear">
        <input id="fTitle" maxlength="60" placeholder="a title for this star…" aria-label="Judul kenangan" autocomplete="off">
        <textarea id="fText" maxlength="300" placeholder="the small thing worth remembering today…" aria-label="Deskripsi kenangan"></textarea>
        <div class="meta"><input id="fDate" type="date" aria-label="Tanggal"><span id="fCount">0/300</span></div>
        <label class="pill pic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg> add a picture<input id="fPhoto" class="sr" type="file" accept="image/*"></label>
        <figure class="polaroid small" id="preview" hidden><img alt="Pratinjau foto"></figure>
      </div>
    </div>
    <p id="error" role="alert"></p>
    <button class="drop" type="submit"><span class="mini img-fallback"></span> drop it in the jar</button>
  </form>
</section>

<section id="listPage" class="page" hidden>
  <button class="back" data-go="home">&larr; back</button>
  <h1 class="left">your paper stars</h1>
  <p id="listCount"></p>
  <div class="filter"><label for="dateFilter">filter by date</label><select id="dateFilter" class="tape-btn"></select></div>
  <ul id="cards" class="cards"></ul>
  <label class="pill">import jar<input id="importFile" class="sr" type="file" accept="application/json"></label>
  <small id="modeNote"></small>
</section>
<div id="toast" role="status"></div>

<dialog id="memoryDialog" aria-labelledby="mTitle">
  <article class="card">
    <i class="tape"></i>
    <figure class="polaroid"><img id="mPhoto" alt=""><div id="mFallback" class="fallback">✦</div></figure>
    <h2 id="mTitle"></h2>
    <time id="mDate"></time>
    <p id="mDesc"></p>
    <div class="row"><button class="pill" id="tuck">tuck it back</button><button class="pill" id="another">unfold another</button></div>
  </article>
</dialog>

<script>
/* Jar of Stars — vanilla JS. Data: IndexedDB. Physics: floating drift loop. Storage: IndexedDB (local) or shared db when published. */
(() => {
/* ===== PENGATURAN GAMBAR PNG (opsional) =====
   Gambar sudah tertanam di file ini (data URI). Jika diganti dengan path file, dan file tidak ada,
   otomatis memakai gambar bawaan (SVG/CSS). Gunakan PNG transparan. */
/* ===== JAR BERSAMA TANPA LOGIN (opsional) =====
   Isi dari proyek Supabase gratis (lihat supabase-setup.sql). Kosong = mode lokal.
   Kunci "anon" memang publik; keamanan diatur oleh aturan RLS di SQL. */
const CLOUD = { url: 'https://ybiktqzfimfhcnpuuicx.supabase.co', key: 'sb_publishable_Fox9RT1X-Qlrz7uhdCDwtw_BMs5oYHw' };
const SKIN = {
  jar: 'data:image/png;base64,',
  stars: ['data:image/png;base64,', 'data:image/png;base64,', 'data:image/png;base64,'],
  // area bintang di dalam toples PNG (persen dari ukuran toples)
  area: { left: '8%', right: '8%', top: '22%', bottom: '6%' }
};
const probe = src => new Promise(ok => { const i = new Image(); i.onload = () => ok(true); i.onerror = () => ok(false); i.src = src; });
let starImgs = [];
async function loadSkins() {
  if (await probe(SKIN.jar)) {
    const im = document.querySelector('.jar-img'); im.src = SKIN.jar; im.hidden = false;
    document.querySelector('.jar svg').style.display = 'none';
    const s = document.querySelector('#stars').style, a = SKIN.area;
    s.setProperty('--sl', a.left); s.setProperty('--sr', a.right); s.setProperty('--st', a.top); s.setProperty('--sb', a.bottom);
  }
  starImgs = [];
  for (const src of SKIN.stars) if (await probe(src)) starImgs.push(src);
}
const $ = s => document.querySelector(s);
const COLORS = ['#f7a98b','#fbb26e','#c7a8ee','#f4b6c8','#f6d68a','#a9d4c4'];
const reduce = matchMedia('(prefers-reduced-motion: reduce)');
const layer = $('#stars'), jar = $('#jar');
let flying = false, hiddenBody = null, skipRestore = false, memories = [], bodies = [], lastId = null, W = 0, H = 0, raf = 0;

/* ---------- IndexedDB ---------- */
const DB = {
  open() { return this.p ||= new Promise((ok, no) => {
    const r = indexedDB.open('jar-of-stars', 1);
    r.onupgradeneeded = () => r.result.createObjectStore('memories', { keyPath: 'id' });
    r.onsuccess = () => ok(r.result); r.onerror = () => no(r.error); }); },
  async tx(mode, fn) { const db = await this.open();
    return new Promise((ok, no) => { const t = db.transaction('memories', mode), q = fn(t.objectStore('memories'));
      t.oncomplete = () => ok(q.result); t.onerror = () => no(t.error); }); },
  all() { return this.tx('readonly', s => s.getAll()); },
  put(m) { return this.tx('readwrite', s => s.put(m)); },
  del(id) { return this.tx('readwrite', s => s.delete(id)); }
};

/* ---------- Store: shared db jika dipublikasikan di claude.ai, kalau tidak IndexedDB lokal ---------- */
const Store = {
  mode: 'local', uid: null, canEdit: false, col: null, mineIds: new Set(JSON.parse(localStorage.getItem('jos-mine') || '[]')),
  get remote() { return this.mode === 'shared' || this.mode === 'cloud'; },
  async api(path, body) {
    const r = await fetch(CLOUD.url.replace(/\/$/, '') + '/rest/v1/' + path, {
      method: body ? 'POST' : 'GET', body: body && JSON.stringify(body),
      headers: { apikey: CLOUD.key, ...(CLOUD.key.startsWith('eyJ') ? { Authorization: 'Bearer ' + CLOUD.key } : {}), 'Content-Type': 'application/json', Prefer: 'return=minimal' } });
    if (!r.ok) throw new Error('http ' + r.status);
    return body ? null : r.json();
  },
  async init() {
    if (CLOUD.url && CLOUD.key && !window.claude?.use) {       // web biasa: tanpa login
      this.mode = 'cloud';
      this.token = localStorage.getItem('jos-token') || (localStorage.setItem('jos-token', crypto.randomUUID()), localStorage.getItem('jos-token'));
      setInterval(() => { if (!document.hidden) load(); }, 20000);
      return;
    }
    if (!window.claude?.use) return;                           // file lokal
    try {
      const db = await Promise.race([claude.use('db'), new Promise(r => setTimeout(() => r(null), 5000))]);
      if (!db) { this.mode = 'blocked'; return; }
      const user = await claude.use('user');
      this.uid = user ? await user.id() : null; this.canEdit = user ? await user.canEdit() : false;
      this.col = db.collection('stars'); this.mode = 'shared';
      this.col.onSnapshot(() => { clearTimeout(this.t); this.t = setTimeout(() => load(), 300); }, () => {});
    } catch { this.mode = 'blocked'; }
  },
  async all() {
    if (this.mode === 'local') return DB.all();
    if (this.mode === 'blocked') return [];
    if (this.mode === 'cloud') return (await this.api('stars?select=id,title,date,descr,photo&order=date.desc&limit=300')).map(r => ({ id: r.id, title: r.title, date: r.date, desc: r.descr, photo: r.photo }));
    return (await this.col.get()).docs.map(d => ({ ...d.data(), id: d.id }));
  },
  async put(m) {
    if (this.mode === 'local') return DB.put(m);
    if (this.mode === 'blocked') throw new Error('blocked');
    if (this.mode === 'cloud') {
      await this.api('stars', { id: m.id, title: m.title, date: m.date, descr: m.desc || '', photo: m.photo || '', owner_token: this.token });
      this.mineIds.add(m.id); localStorage.setItem('jos-mine', JSON.stringify([...this.mineIds])); return;
    }
    return this.col.doc(m.id).set({ ...m, owner: this.uid || '', at: Date.now() });
  },
  async del(id) {
    if (this.mode === 'local') return DB.del(id);
    if (this.mode === 'cloud') { await this.api('rpc/delete_star', { p_id: id, p_token: this.token }); this.mineIds.delete(id); localStorage.setItem('jos-mine', JSON.stringify([...this.mineIds])); return; }
    return this.col.doc(id).delete();
  },
  mine(m) { return this.mode === 'local' || (this.mode === 'cloud' ? this.mineIds.has(m.id) : this.canEdit || (!!this.uid && m.owner === this.uid)); }
};

const SAMPLES = [
  { title: 'perjalanan', date: '2026-10-09', desc: 'Contoh kenangan. Hapus lewat tombol "+ fold a memory".' },
  { title: 'hari yang hangat', date: '2026-08-17', desc: 'Sore itu langit oranye dan kita tertawa tanpa alasan.' },
  { title: 'kopi pertama', date: '2026-05-02', desc: 'Kopi dingin, obrolan panjang.' }
];

/* ---------- Render & physics ---------- */
const fmt = d => new Date(d + 'T00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
function measure() { const r = layer.getBoundingClientRect(); W = r.width; H = r.height; }

function render() {
  measure(); layer.replaceChildren(); bodies = []; hiddenBody = null;
  memories.forEach((m, i) => {
    const el = document.createElement('button');
    el.className = 'star'; el.style.setProperty('--c', COLORS[i % COLORS.length]);
    if (starImgs.length) { el.classList.add('img'); el.style.setProperty('--img', `url("${starImgs[i % starImgs.length]}")`); }
    el.setAttribute('aria-label', 'Buka kenangan: ' + m.title); el.innerHTML = '<span></span>';
    el.addEventListener('click', e => { e.stopPropagation(); reveal(m); });
    layer.append(el);
    const s = .35 + Math.random() * .45, ang = Math.random() * 6.283;
    bodies.push({ el, m, r: 15, x: 15 + Math.random() * Math.max(1, W - 30), y: 15 + Math.random() * Math.max(1, H - 30), s, vx: Math.cos(ang) * s, vy: Math.sin(ang) * s,
      rot: Math.random() * 360, vr: 0, w: (Math.random() < .5 ? -1 : 1) * (.2 + Math.random() * .5), frozen: false });
  });
  $('#count').textContent = memories.length
    ? `${memories.length} star${memories.length > 1 ? 's' : ''} captured inside.`
    : 'the jar is empty — fold your first memory.';
  paint(); kick();
}
function paint() { for (const b of bodies) b.el.style.transform = `translate(${b.x - b.r}px,${b.y - b.r}px) rotate(${b.rot}deg)`; }
/* Bintang melayang bebas (tanpa gravitasi): kecepatan menuju laju jelajah masing-masing,
   dengan sedikit arah acak, memantul di dinding kaca. */
function kick() { if (!raf && !reduce.matches) raf = requestAnimationFrame(step); }
function step() {
  if (document.hidden || pages.home.hidden) { raf = 0; return; }
  for (const b of bodies) {
    if (b.frozen) continue;
    b.vx += (Math.random() - .5) * .07; b.vy += (Math.random() - .5) * .07;
    const sp = Math.hypot(b.vx, b.vy) || .01, k = sp > b.s * 1.15 ? .97 : sp < b.s * .85 ? 1.03 : 1;
    b.vx *= k; b.vy *= k; b.vr += (b.w - b.vr) * .02; b.rot += b.vr; b.x += b.vx; b.y += b.vy;
    if (b.x < b.r) { b.x = b.r; b.vx = Math.abs(b.vx); } else if (b.x > W - b.r) { b.x = W - b.r; b.vx = -Math.abs(b.vx); }
    if (b.y < b.r) { b.y = b.r; b.vy = Math.abs(b.vy); } else if (b.y > H - b.r) { b.y = H - b.r; b.vy = -Math.abs(b.vy); }
  }
  for (let i = 0; i < bodies.length; i++) for (let j = i + 1; j < bodies.length; j++) {
    const a = bodies[i], c = bodies[j], dx = c.x - a.x, dy = c.y - a.y, d = Math.hypot(dx, dy) || 1, min = a.r + c.r - 4;
    if (d < min) { const p = (min - d) / 2, nx = dx / d, ny = dy / d;
      a.x -= nx * p; a.y -= ny * p; c.x += nx * p; c.y += ny * p; a.vx -= nx * .3; a.vy -= ny * .3; c.vx += nx * .3; c.vy += ny * .3; }
  }
  paint(); raf = requestAnimationFrame(step);
}
document.addEventListener('visibilitychange', kick);

/* ---------- Shake + random ---------- */
function shake() {
  if (!reduce.matches) {
    jar.classList.remove('shaking'); void jar.offsetWidth; jar.classList.add('shaking'); jar.addEventListener('animationend', () => jar.classList.remove('shaking'), { once: true });
    bodies.forEach(b => { const a = Math.random() * 6.283, f = 6 + Math.random() * 7; b.vx = Math.cos(a) * f; b.vy = Math.sin(a) * f; b.vr = (Math.random() - .5) * 16; });
    kick(); sparkle();
  }
}
function sparkle() {
  for (let i = 0; i < 10; i++) {
    const s = document.createElement('i'); s.className = 'spark';
    s.style.left = Math.random() * W + 'px'; s.style.top = Math.random() * H + 'px';
    s.style.setProperty('--dx', (Math.random() - .5) * 60 + 'px'); s.style.setProperty('--dy', -20 - Math.random() * 50 + 'px');
    layer.append(s); s.addEventListener('animationend', () => s.remove());
  }
}
function randomMemory() {
  if (!memories.length) return;
  const pool = memories.filter(m => m.id !== lastId);
  reveal((pool.length ? pool : memories)[Math.floor(Math.random() * (pool.length || memories.length))]);
}
jar.addEventListener('click', () => { if (flying) return; if (!memories.length) return show('add'); shake(); setTimeout(randomMemory, reduce.matches ? 0 : 750); });

/* ---------- Memory dialog ---------- */
const md = $('#memoryDialog');
function openMemory(m) {
  lastId = m.id;
  $('#mTitle').textContent = `"${m.title}"`; $('#mDate').textContent = fmt(m.date); $('#mDesc').textContent = m.desc || '';
  const img = $('#mPhoto'), fb = $('#mFallback');
  img.hidden = !m.photo; fb.hidden = !!m.photo;
  img.onerror = () => { img.hidden = true; fb.hidden = false; };
  if (m.photo) img.src = m.photo;
  if (md.open) { md.close(); } md.showModal();
}
$('#tuck').onclick = () => md.close();
md.addEventListener('close', () => { if (skipRestore) { skipRestore = false; return; } restore(); });

/* ---------- Star flies out of / back into the jar ---------- */
const at = (x, y, s, r) => `translate(${x - 17}px,${y - 17}px) scale(${s}) rotate(${r}deg)`;
function makeFly(el) {
  const f = document.createElement('div'); f.className = 'flystar' + (el.classList.contains('img') ? ' img' : '');
  f.style.setProperty('--c', el.style.getPropertyValue('--c')); f.style.setProperty('--img', el.style.getPropertyValue('--img'));
  f.innerHTML = '<span></span>'; document.body.append(f); return f;
}
async function reveal(m) {
  if (flying) return; flying = true;
  if (md.open) { skipRestore = true; md.close(); }
  if (hiddenBody) { hiddenBody.el.style.visibility = ''; hiddenBody.frozen = false; hiddenBody = null; }
  const b = bodies.find(x => x.m.id === m.id);
  if (!b || reduce.matches || pages.home.hidden) { flying = false; return openMemory(m); }
  const lr = layer.getBoundingClientRect(), jr = jar.getBoundingClientRect();
  const sx = lr.left + b.x, sy = lr.top + b.y, mx = jr.left + jr.width / 2;
  const f = makeFly(b.el);
  b.el.style.visibility = 'hidden'; b.frozen = true; hiddenBody = b;
  const a = f.animate([
    { transform: at(sx, sy, 1, b.rot), opacity: 1, offset: 0 },
    { transform: at(mx + (sx - mx) * .3, jr.top + jr.height * .12, 1.4, b.rot + 120), offset: .3 },
    { transform: at(mx, jr.top - 50, 2.4, b.rot + 240), offset: .55 },
    { transform: at(innerWidth / 2, Math.max(150, innerHeight * .38), 5.5, b.rot + 360), opacity: 1, offset: .85 },
    { transform: at(innerWidth / 2, Math.max(150, innerHeight * .38), 7, b.rot + 380), opacity: 0, offset: 1 }
  ], { duration: 1200, easing: 'cubic-bezier(.45,.05,.25,1)' });
  try { await a.finished; } catch {}
  f.remove(); flying = false; openMemory(m);
}
async function restore() {
  const b = hiddenBody; if (!b) return; hiddenBody = null;
  if (reduce.matches) { b.el.style.visibility = ''; return; }
  const lr = layer.getBoundingClientRect(), jr = jar.getBoundingClientRect(), mx = jr.left + jr.width / 2;
  const f = makeFly(b.el), cy = Math.max(150, innerHeight * .38);
  flying = true;
  const a = f.animate([
    { transform: at(innerWidth / 2, cy, 5, 0), offset: 0 },
    { transform: at(mx, jr.top - 40, 2, -180), offset: .5 },
    { transform: at(mx, jr.top + jr.height * .2, 1.2, -300), offset: .75 },
    { transform: at(lr.left + b.x, lr.top + b.y, 1, b.rot), offset: 1 }
  ], { duration: 800, easing: 'cubic-bezier(.4,0,.3,1)' });
  try { await a.finished; } catch {}
  f.remove(); b.el.style.visibility = ''; b.frozen = false; kick(); flying = false;
}
$('#another').onclick = randomMemory;
for (const d of document.querySelectorAll('dialog')) d.addEventListener('click', e => { if (e.target === d) d.close(); });

/* ---------- Pages ---------- */
const pages = { home: $('#home'), add: $('#addPage'), list: $('#listPage') };
function show(name) {
  for (const [k, el] of Object.entries(pages)) el.hidden = k !== name;
  scrollTo(0, 0);
  if (name === 'home') { measure(); render(); }
  if (name === 'add') { $('#fDate').value = new Date().toLocaleDateString('en-CA'); }
  if (name === 'list') drawList();
}
document.addEventListener('click', e => { const t = e.target.closest('[data-go]'); if (t) show(t.dataset.go); });
let tt; function toast(msg) { const t = $('#toast'); t.textContent = msg; t.classList.add('on'); clearTimeout(tt); tt = setTimeout(() => t.classList.remove('on'), 3500); }

/* ---------- Add a memory (local only, NOT secure) ---------- */
const form = $('#form'), err = $('#error');
let photoData = '';
$('#fText').oninput = e => { $('#fCount').textContent = `${e.target.value.length}/300`; };
$('#fPhoto').onchange = async e => {
  const f = e.target.files[0], pv = $('#preview'); photoData = ''; pv.hidden = true; if (!f) return;
  try {
    const bmp = await createImageBitmap(f), s = Math.min(1, (Store.remote ? 640 : 900) / Math.max(bmp.width, bmp.height)), c = document.createElement('canvas');
    c.width = bmp.width * s; c.height = bmp.height * s; c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
    let q = Store.remote ? .7 : .82; photoData = c.toDataURL('image/jpeg', q);
    while (Store.remote && photoData.length > 170000 && q > .3) { q -= .1; photoData = c.toDataURL('image/jpeg', q); }
    if (photoData.length > 190000 && Store.mode === 'shared') { photoData = ''; err.textContent = 'Foto terlalu besar untuk jar bersama. Pilih foto lain.'; return; }
    pv.querySelector('img').src = photoData; pv.hidden = false;
  } catch { err.textContent = 'Foto tidak bisa dibaca. Coba JPG atau PNG.'; }
};
form.onsubmit = async e => {
  e.preventDefault();
  const title = $('#fTitle').value.trim(), desc = $('#fText').value.trim(), date = $('#fDate').value;
  if (!title || !desc || !date) { err.textContent = 'Judul, deskripsi, dan tanggal wajib diisi.'; return; }
  try { await Store.put({ id: crypto.randomUUID(), title, date, desc, photo: photoData }); }
  catch { err.textContent = Store.mode === 'cloud' ? 'Tidak bisa menyimpan. Periksa koneksi internet.' : 'Tidak bisa menyimpan. Pastikan sudah masuk dan punya izin Contributor.'; return; }
  form.reset(); photoData = ''; $('#preview').hidden = true; err.textContent = ''; $('#fCount').textContent = '0/300';
  await load(); show('home'); setTimeout(shake, 350); toast('a new star dropped in the jar');
};

/* ---------- View all stars ---------- */
const TINTS = ['#dfe3cf', '#efdccf', '#e3d9ee', '#f3dfe0'];
function drawList() {
  const sel = $('#dateFilter'), cur = sel.value || 'all';
  const months = [...new Set(memories.map(m => m.date.slice(0, 7)))];
  sel.replaceChildren(new Option('all dates', 'all'));
  months.forEach(k => sel.append(new Option(new Date(k + '-01T00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' }), k)));
  sel.value = months.includes(cur) ? cur : 'all';
  $('#listCount').textContent = `${memories.length} folded and kept.`;
  $('#modeNote').textContent = { local: 'Data tersimpan di browser ini saja. Pakai "share jar" untuk mengirim cadangan, lalu "import jar" di perangkat lain.',
    shared: 'Jar bersama: bintang tersimpan di server dan terlihat oleh semua orang yang diberi akses.',
    cloud: 'Jar bersama online: siapa pun yang membuka link ini bisa melihat dan menambah bintang. Kamu hanya bisa menghapus bintang yang dibuat dari perangkat ini.',
    blocked: 'Masuk ke claude.ai dan minta akses ke jar ini untuk melihat dan menambah bintang.' }[Store.mode];
  const ul = $('#cards'); ul.replaceChildren();
  memories.forEach((m, i) => {
    if (sel.value !== 'all' && !m.date.startsWith(sel.value)) return;
    const li = document.createElement('li'), open = document.createElement('button'), ic = document.createElement('span'),
      t = document.createElement('strong'), d = document.createElement('time'), del = document.createElement('button');
    li.style.setProperty('--tint', TINTS[i % 4]); li.style.setProperty('--rot', (i % 2 ? 1 : -1) * (.6 + (i % 3) * .4) + 'deg');
    ic.className = 'mini' + (starImgs.length ? ' img' : ''); ic.style.setProperty('--c', COLORS[i % COLORS.length]);
    if (starImgs.length) ic.style.setProperty('--img', `url("${starImgs[i % starImgs.length]}")`);
    open.className = 'open'; t.textContent = m.title; d.textContent = fmt(m.date); open.append(ic, t, d); open.onclick = () => openMemory(m);
    del.className = 'del'; del.textContent = '×'; del.setAttribute('aria-label', 'Hapus ' + m.title);
    del.onclick = async () => { if (confirm(`Hapus "${m.title}"?`)) { try { await Store.del(m.id); await load(); } catch { toast('Tidak punya izin menghapus.'); } } };
    li.append(open); if (Store.mine(m)) li.append(del); ul.append(li);
  });
}
$('#dateFilter').onchange = drawList;

/* ---------- Share jar = export file; import jar = restore ---------- */
$('#shareJar').onclick = async () => {
  if (Store.mode !== 'local') {
    const url = location.href;
    try { if (navigator.share) { await navigator.share({ url, title: 'jar of stars' }); return; } await navigator.clipboard.writeText(url); toast('link copied. people you invite can see and add stars.'); }
    catch (e) { if (e.name !== 'AbortError') toast(url); }
    return;
  }
  const file = new File([JSON.stringify({ app: 'jar-of-stars', v: 1, memories })], 'jar-of-stars.json', { type: 'application/json' });
  if (navigator.canShare?.({ files: [file] })) { try { await navigator.share({ files: [file], title: 'my jar of stars' }); return; } catch (e) { if (e.name === 'AbortError') return; } }
  const a = document.createElement('a'); a.href = URL.createObjectURL(file); a.download = file.name; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  toast('jar saved as a file. send it to a friend, they can import it.');
};
$('#importFile').onchange = async e => {
  const f = e.target.files[0]; e.target.value = ''; if (!f) return;
  try {
    const j = JSON.parse(await f.text()), arr = Array.isArray(j) ? j : j.memories; if (!Array.isArray(arr)) throw 0; let n = 0;
    for (const m of arr) {
      if (typeof m.title !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(m.date || '')) continue;
      await Store.put({ id: String(m.id || crypto.randomUUID()).slice(0, 60), title: m.title.slice(0, 300), date: m.date,
        desc: typeof m.desc === 'string' ? m.desc.slice(0, 400) : '', photo: /^data:image\//.test(m.photo || '') ? m.photo : '' }); n++;
    }
    await load(); toast(`${n} stars imported`);
  } catch { toast('file tidak valid'); }
};

async function load() { memories = (await Store.all()).sort((a, b) => b.date.localeCompare(a.date)); if (!pages.list.hidden) drawList(); else if (!pages.home.hidden) render(); }
(async () => {
  try {
    await Store.init();
    if (Store.mode === 'local' && !(await DB.all()).length && !localStorage.getItem('jos-seeded')) {
      localStorage.setItem('jos-seeded', '1');
      for (const s of SAMPLES) await Store.put({ ...s, id: crypto.randomUUID(), photo: '' });
    }
    await loadSkins(); await load();
  } catch { $('#count').textContent = 'Penyimpanan tidak tersedia di browser ini.'; }
})();
addEventListener('resize', () => { measure(); kick(); });
})();

</script>
